# Cấu hình app (production). Copy thành deploy/api.env (đã gitignore) rồi điền giá trị thật.
# Mỗi dòng KEY=VALUE, không dùng dấu nháy, không comment cuối dòng; ":" trong key cấu hình viết thành "__".
# Connection string, Redis, migration, TrustedProxy__Secret, Ordering__AdminBaseUrl do docker-compose.prod.yml
# đặt từ deploy/.env, không khai báo ở đây.
# Dòng tùy chọn để comment (#) khi chưa dùng: bỏ comment là ghi đè giá trị mặc định, kể cả bằng chuỗi rỗng.

# --- Bắt buộc ---
Jwt__SigningKey=change-me-to-a-random-string-of-at-least-32-characters

# --- Super Admin đầu tiên (comment lại sau khi đã tạo) ---
# Auth__BootstrapAdmin__Email=admin@example.com
# Auth__BootstrapAdmin__Password=change-me-strong-password
# Auth__TrustedDeviceSuperAdminEmails__0=admin@example.com

# --- Dịch vụ ngoài ---
# Cloudinary__CloudName=your-cloud-name
# Cloudinary__ApiKey=123456789012345
# Cloudinary__ApiSecret=change-me

# Pusher__AppId=
# Pusher__Key=
# Pusher__Secret=
# Pusher__Cluster=ap1

# SePay__ApiKey=change-me-sepay-webhook-api-key
# SePay__AccountNumber=0123456789
# SePay__BankName=MBBank
# SePay__AccountName=CONG TY SACH LUAT VIET NAM

# Zalo__Enabled=true
# Zalo__BotToken=123456789:change-me
# Zalo__ChatId=change-me
