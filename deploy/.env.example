# Biến cho deploy/docker-compose.prod.yml. Copy thành deploy/.env (đã gitignore) rồi điền giá trị thật.

# Mật khẩu PostgreSQL. Chỉ dùng chữ và số vì nằm trong connection string: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# Major version PostgreSQL, phải trùng Neon khi chuyển dữ liệu (docs/deploy-linux.md).
# Đổi sau khi đã có dữ liệu thì phải dump/restore lại.
POSTGRES_VERSION=16

# Secret giữa proxy FE và API (TrustedProxy:Secret), >= 32 ký tự: openssl rand -hex 32
PROXY_SECRET=change-me-random-string-of-at-least-32-characters

# URL public, không có dấu / cuối. ADMIN_URL dùng cho link trong tin nhắn Zalo; STOREFRONT_URL cho nút
# đăng nhập hộ khách ở admin (gắn vào JavaScript lúc build: đổi thì chạy lại update.sh).
STOREFRONT_URL=https://sachluat.example.com
ADMIN_URL=https://admin.sachluat.example.com

# Pusher cho FE (gắn vào JavaScript lúc build), trùng Pusher__Key / Pusher__Cluster trong api.env. Để trống thì tắt.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Thư mục repo FE, tính từ thư mục deploy/. Mặc định: repo FE nằm cạnh repo BE.
FE_DIR=../../sachphapluatvietnam-FE

# Token của tunnel: Cloudflare Zero Trust > Networks > Tunnels > (tunnel) > Docker, chuỗi sau --token.
CLOUDFLARE_TUNNEL_TOKEN=change-me
