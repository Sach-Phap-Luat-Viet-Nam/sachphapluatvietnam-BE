# Cau hinh production cho Windows Service: deploy.ps1 nap file nay vao bien moi truong cua service.
# Copy ra NGOAI repo (vd %USERPROFILE%\sachluat\service.env), dien gia tri that, khong commit.
# Moi dong KEY=VALUE, khong dung dau nhay; dau ":" trong key cau hinh viet thanh "__".
# Bien de trong bi bo qua (app dung gia tri mac dinh). ASPNETCORE_URLS do deploy.ps1 dat theo -Port.

# --- Bat buoc ---
ConnectionStrings__Default=Host=localhost;Port=5433;Database=sachluat;Username=sachluat;Password=change-me
ConnectionStrings__Redis=localhost:6380
Jwt__SigningKey=change-me-to-a-random-string-of-at-least-32-characters

# Mot instance duy nhat nen tu ap migration khi khoi dong (xem docs/deploy-windows.md).
Database__ApplyMigrationsOnStartup=true

# Trung PROXY_SECRET ben FE (Vercel), >= 32 ky tu.
TrustedProxy__Secret=change-me-random-string-of-at-least-32-characters

# --- Super Admin dau tien (xoa 2 dong sau khi da tao) ---
Auth__BootstrapAdmin__Email=
Auth__BootstrapAdmin__Password=
Auth__TrustedDeviceSuperAdminEmails__0=

# --- Dich vu ngoai ---
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

Pusher__AppId=
Pusher__Key=
Pusher__Secret=
Pusher__Cluster=ap1

SePay__ApiKey=
SePay__AccountNumber=
SePay__BankName=
SePay__AccountName=

Zalo__Enabled=false
Zalo__BotToken=
Zalo__ChatId=

Ordering__AdminBaseUrl=https://admin.example.com

# Them origin FE moi (neu doi domain) tu chi so 4 tro di: appsettings.json da co 4 origin o chi so 0-3,
# ghi de __0 se thay origin dau tien thay vi them moi.
# Cors__AllowedOrigins__4=https://sachluat.example.com
