{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "sachluat-api",
    "Audience": "sachluat-web",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 30,
    "SessionRefreshTokenHours": 12
  },
  "Cart": {
    "MaxQuantityPerSku": 20,
    "LifetimeDays": 30
  },
  "Ordering": {
    "ShippingFlatFee": 30000,
    "FreeShippingThreshold": 300000,
    "PaymentTimeoutMinutes": 30,
    "MaxQuantityPerSku": 20
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10
  },
  "Cors": {
    "AllowedOrigins": [
      "https://sachphapluatvietnam.vercel.app",
      "https://admin-sachphapluatvietnam.vercel.app",
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  }
}
